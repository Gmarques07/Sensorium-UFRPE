# Arquivo de exemplo para o ambiente de PRODUÇÃO (AWS).
# Copie este arquivo para .env.prod no seu servidor de produção e preencha com os valores corretos.
# NÃO adicione este arquivo ao git, exceto este exemplo.

# ==============================================================================
# Configuração de Ambiente
# ==============================================================================
ENVIRONMENT=production

# ==============================================================================
# Configurações do Banco de Dados (RDS da AWS, por exemplo)
# ==============================================================================
# Substitua com o host do seu banco de dados de produção
MYSQL_HOST=
# Substitua com o usuário do seu banco de dados de produção
MYSQL_USER=
# Substitua com a senha do seu banco de dados de produção
MYSQL_PASSWORD=
# Substitua com o nome do seu banco de dados de produção
MYSQL_DATABASE=
MYSQL_PORT=3306
# A DATABASE_URL será construída a partir das variáveis acima.
# Se você tiver uma URL de conexão completa (ex: do RDS), pode usá-la diretamente:
# DATABASE_URL=

# ==============================================================================
# Configurações de Segurança
# ==============================================================================
# IMPORTANTE: Gere uma chave forte e única para produção.
# Você pode gerar uma com: openssl rand -hex 32
SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=1440 # 24 horas

# ==============================================================================
# Configurações de E-mail (Ex: Amazon SES)
# ==============================================================================
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAILS_FROM_EMAIL=

# ==============================================================================
# Configurações do Google OAuth2
# ==============================================================================
# !!! PREENCHA COM SUAS CREDENCIAIS DE PRODUÇÃO DO GOOGLE CLOUD CONSOLE !!!
GOOGLE_CLIENT_ID=COLOQUE_SEU_CLIENT_ID_DE_PRODUCAO_AQUI
GOOGLE_CLIENT_SECRET=COLOQUE_SEU_CLIENT_SECRET_DE_PRODUCAO_AQUI
# A URL de redirect para produção já está configurada no código para usar
# https://sensoriumtech.online/api/v1/oauth/google/callback
# Você pode sobrescrever aqui se o seu domínio for diferente:
GOOGLE_REDIRECT_URI=https://sensoriumtech.online/api/v1/oauth/google/callback

# ==============================================================================
# Configuração da URL Base da Aplicação
# ==============================================================================
BASE_URL="https://sensoriumtech.online"
API_BASE_URL="https://sensoriumtech.online"
