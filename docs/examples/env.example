# Configurações do Sistema Sensorium UFRPE
# Copie este arquivo para .env e ajuste as configurações conforme necessário

# ===========================================
# CONFIGURAÇÕES DO BANCO DE DADOS
# ===========================================

# Host do MySQL (use 'host.docker.internal' para Docker)
MYSQL_HOST=localhost

# Porta do MySQL
MYSQL_PORT=3306

# Usuário do banco de dados
MYSQL_USER=root

# Senha do banco de dados (deixe vazio se não houver senha)
MYSQL_PASSWORD=

# Nome do banco de dados
MYSQL_DATABASE=banco_de_dados

# ===========================================
# CONFIGURAÇÕES DE SEGURANÇA
# ===========================================

# Chave secreta para JWT (GERE UMA CHAVE SEGURA!)
SECRET_KEY=sua_chave_secreta_muito_longa_e_segura_para_jwt_tokens_aqui

# Tempo de expiração do token em minutos (1440 = 24 horas)
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ===========================================
# CONFIGURAÇÕES DO SERVIDOR
# ===========================================

# URL base da aplicação
BASE_URL=http://localhost:8000

# Ambiente (development, production, testing)
ENVIRONMENT=development

# ===========================================
# CONFIGURAÇÕES DE CORS
# ===========================================

# Origens permitidas para CORS (separadas por vírgula)
# Use ["*"] para permitir todas as origens (apenas para desenvolvimento)
BACKEND_CORS_ORIGINS=["*"]

# ===========================================
# CONFIGURAÇÕES DE LOG
# ===========================================

# Nível de log (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=debug

# ===========================================
# CONFIGURAÇÕES ESPECÍFICAS DO DOCKER
# ===========================================

# Para usar com Docker, descomente e ajuste:
# MYSQL_HOST=host.docker.internal
# BASE_URL=http://localhost:8001

# ===========================================
# CONFIGURAÇÕES AVANÇADAS
# ===========================================

# Configurações de rate limiting (opcional)
# RATE_LIMIT_ENABLED=true
# RATE_LIMIT_REQUESTS=100
# RATE_LIMIT_WINDOW=60

# Configurações de email (para notificações - opcional)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=seu_email@gmail.com
# SMTP_PASSWORD=sua_senha_de_app
# SMTP_TLS=true

# ===========================================
# INSTRUÇÕES
# ===========================================

# 1. Copie este arquivo para .env:
#    cp env.example .env

# 2. Ajuste as configurações conforme seu ambiente

# 3. Para Docker:
#    - Use MYSQL_HOST=host.docker.internal
#    - Use BASE_URL=http://localhost:8001

# 4. Para desenvolvimento local:
#    - Use MYSQL_HOST=localhost
#    - Use BASE_URL=http://localhost:8000

# 5. IMPORTANTE: Nunca commite o arquivo .env com dados reais!
