import os
from flask import Flask, render_template

app = Flask(__name__)
app.secret_key = os.urandom(24)

# Rotas básicas mantidas temporariamente para renderização de templates
# Estas serão removidas quando o frontend for separado da API

@app.route('/')
def pagina_inicial():
    """Página inicial - será substituída por frontend separado"""
    return render_template('index.html')

@app.route('/sobre')
def sobre():
    """Página sobre - será substituída por frontend separado"""
    return render_template('sobre.html')

@app.errorhandler(404)
def pagina_nao_encontrada(error):
    """Página 404 - será substituída por frontend separado"""
    return render_template('404.html'), 404

@app.errorhandler(500)
def internal_server_error(e):
    """Página 500 - será substituída por frontend separado"""
    return render_template('500.html'), 500

if __name__ == '__main__':
    # Esta aplicação Flask será descontinuada após a migração completa
    # e substituição do frontend
    app.run(host='0.0.0.0', port=5000, debug=True)
