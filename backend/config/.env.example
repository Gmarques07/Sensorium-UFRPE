# Arquivo de configuração de ambiente (.env)
# Copie este arquivo para .env e ajuste os valores conforme necessário

# Configurações do Banco de Dados
MYSQL_USER=sensorium_user
MYSQL_PASSWORD=sensorium_password
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=sensorium_db

# Configuração JWT
SECRET_KEY=chave_secreta_muito_longa_e_segura_para_jwt_tokens_aqui
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# URL base
BASE_URL=http://localhost:8000

# Ambiente (development, production)
ENVIRONMENT=development

# Configurações de E-mail (opcional - para envio de relatórios)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=seu_email@gmail.com
# SMTP_PASSWORD=sua_senha_de_app
# EMAILS_FROM_EMAIL=seu_email@gmail.com
# EMAILS_FROM_NAME=Sensorium UFRPE